# Gemini API Key (공통 - AI 초안 생성용)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AI 블로그 (노션 에디터만 저장됨, 네이버 블로그는 수동 작업용)
VITE_AI_NOTION_API_KEY=your_notion_api_key_here
VITE_AI_NOTION_DATABASE_ID=your_notion_database_id_here

# 테크/IT 리뷰
VITE_TECH_NOTION_API_KEY=your_notion_api_key_here
VITE_TECH_NOTION_DATABASE_ID=your_notion_database_id_here

# 부동산
VITE_REAL_ESTATE_NOTION_API_KEY=your_notion_api_key_here
VITE_REAL_ESTATE_NOTION_DATABASE_ID=your_notion_database_id_here

# 주식
VITE_STOCK_NOTION_API_KEY=your_notion_api_key_here
VITE_STOCK_NOTION_DATABASE_ID=your_notion_database_id_here

# 정부정책
VITE_POLICY_NOTION_API_KEY=your_notion_api_key_here
VITE_POLICY_NOTION_DATABASE_ID=your_notion_database_id_here

# 병원
VITE_HOSPITAL_NOTION_API_KEY=your_notion_api_key_here
VITE_HOSPITAL_NOTION_DATABASE_ID=your_notion_database_id_here

# 맛집
VITE_RESTAURANT_NOTION_API_KEY=your_notion_api_key_here
VITE_RESTAURANT_NOTION_DATABASE_ID=your_notion_database_id_here

# 여행
VITE_TRAVEL_NOTION_API_KEY=your_notion_api_key_here
VITE_TRAVEL_NOTION_DATABASE_ID=your_notion_database_id_here

# SEO
VITE_SEO_NOTION_API_KEY=your_notion_api_key_here
VITE_SEO_NOTION_DATABASE_ID=your_notion_database_id_here

# Naver API (맛집 검색용 - Vercel 서버리스 함수에서 사용)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Gemini API (맛집 정보 추출용 - Vercel 서버리스 함수에서 사용)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Places API (맛집 검색용 - Vercel 서버리스 함수에서 사용)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
